# Copy to .env.local (or just use these values — both are safe in a browser
# bundle). The publishable key is designed to be public: it grants only what
# RLS policies allow, and the iOS app ships the same key.
#
# NEVER put the service role key here. It bypasses RLS entirely, and Vite
# inlines every VITE_* variable into the shipped JavaScript.
VITE_SUPABASE_URL=https://gbwhdieifcfrgzazpgas.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_FRpQCxJMhvvnGJCofzqSEg_ISf6rHuG
